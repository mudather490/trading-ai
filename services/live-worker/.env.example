# =============================================================================
# Live worker environment.
#
# Copy to `.env` and fill in. NEVER commit `.env`.
#
# Custody rule: venue credentials live HERE and only here. Vercel receives the
# Supabase URL, the Supabase anon key and the service role key — and nothing
# else. If you find yourself adding an Alpaca or OANDA key to Vercel, stop.
# =============================================================================

# ---------------------------------------------------------------- database --
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------------- worker --
WORKER_ID=live-worker-1
HEARTBEAT_SECONDS=10
REALTIME_BUNDLE_SECONDS=5
TIMEFRAMES=1m,5m,1h,1d
# How often the economic calendar is refreshed. The schedule changes on its
# own, so a stale calendar is a calendar that lies.
CALENDAR_REFRESH_HOURS=6
LOG_LEVEL=INFO

# ------------------------------------------------------------------ venues --
# Which venues to connect. A venue without credentials is skipped, not fatal.
# Binance needs no key. Alpaca and OANDA do.
ENABLED_VENUES=binance,alpaca,oanda

# Binance: public market data needs NO key. The keys below are only for
# execution, which is Phase 5 and does not exist yet.
BINANCE_SYMBOLS=btcusdt,ethusdt,solusdt
BINANCE_WS_BASE=wss://stream.binance.com:9443
BINANCE_REST_BASE=https://api.binance.com

# Alpaca: US equities. Basic (free) plan gives IEX only, which is a fraction
# of consolidated volume. Every US row carries that fact.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_SYMBOLS=QQQ,SPY,GLD,AAPL,NVDA,TLT
ALPACA_WS_BASE=wss://stream.data.alpaca.markets/v2/iex

# OANDA: forex and metals. PRACTICE account only. Rates are indicative.
OANDA_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_SYMBOLS=EUR_USD,GBP_USD,XAU_USD
OANDA_STREAM_BASE=https://stream-fxpractice.oanda.com

# ---------------------------------------------------------------------- AI --
# The AI sidecar. Free tiers receive PUBLIC MARKET NEWS ONLY. Never send
# user data, journal entries, tickets or portfolio information to a free
# provider: Gemini's free tier may use content to improve its products.
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_API_KEY=

# ---------------------------------------------------------------- calendar --
# The economic calendar (Finnhub free tier). Without this key the calendar
# stays empty and no event-risk warning is published.
FINNHUB_API_KEY=

# ------------------------------------------------------------------ alerts --
# The bot token is shared with the web tier: the worker SENDS alerts, the
# webhook ANSWERS commands. Both need it; neither exposes it to a browser.
#
# The chat is NOT configured here. A chat is linked from the app (Settings →
# Telegram), which mints a single-use code. That is deliberate: a chat id in
# an env file is a chat id that can be copied into the wrong place.
TELEGRAM_BOT_TOKEN=

# Only needed by the local relay (tools/telegram_longpoll.mjs), and it must
# match TELEGRAM_WEBHOOK_SECRET in the web tier exactly.
TELEGRAM_WEBHOOK_SECRET=

# ------------------------------------------------------------------- sec ---
# SEC EDGAR asks you to identify yourself. Use a real address.
SEC_USER_AGENT=Your Name you@example.com
